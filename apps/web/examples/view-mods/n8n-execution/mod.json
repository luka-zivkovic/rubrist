{
  "id": "n8n-execution",
  "name": "n8n workflow execution",
  "version": "0.5.0",
  "contract": "rubrist/view-mod/v1",
  "renders": [
    "n8n-execution/v1"
  ],
  "views": [
    {
      "kind": "embed",
      "title": "Workflow canvas · drawn by n8n",
      "src": "https://n8n-preview-service.internal.n8n.cloud/workflows/demo?theme={theme}",
      "height": 420,
      "ready": {
        "command": "n8nReady"
      },
      "send": {
        "command": "openWorkflow",
        "workflow": {
          "$value": "input.workflow"
        },
        "hideNodeIssues": true
      },
      "sendAs": "json-text",
      "caption": "This shows how the workflow is built, not what happened in this run. Warning marks on nodes are n8n’s own checks on its preview page, such as missing credentials, not errors from this run."
    },
    {
      "kind": "graph",
      "title": "input.workflow.name",
      "nodes": {
        "each": "input.workflow.nodes.*",
        "id": "name",
        "label": "name",
        "caption": "type",
        "x": "position.0",
        "y": "position.1"
      },
      "edges": {
        "each": "input.workflow.connections.{source}.main.{port}.*",
        "source": "{source}",
        "target": "node",
        "port": "{port}"
      },
      "steps": {
        "node": "name",
        "status": "metadata.status",
        "errorStatuses": [
          "error"
        ],
        "durationMs": "metadata.executionTimeMs",
        "error": "metadata.error"
      }
    }
  ]
}
